# Planorama Environment Configuration
# Copy this file to .env.local and configure your credentials.

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth Redirect URI (Must match the Authorized Redirect URI in Google Cloud Console)
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# For production (replace with your domain):
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# 32-character hexadecimal string or 32+ character random secret for AES-256-GCM encryption of stored tokens at rest
# Generate one with: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# App URL for absolute redirects and webhook origins
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Session encryption secret (defaults to GOOGLE_ENCRYPTION_SECRET if not set)
SESSION_SECRET=your_session_cookie_secret_here
